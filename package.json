{
  "name": "plant-perception-pathways",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plant Perception Pathways — how plants sense, from stimulus to receptor to response, with structures and evidence. Static, on-device. A host of @actualizer/perception-core.",
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build": "npm run build:content && tsc -b && vite build && tsx scripts/postbuild.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:pack": "python3 tools/validate_pack.py content-pack && python3 tools/validate_extension.py content-pack",
    "lint:dist": "tsx scripts/lint-dist.ts dist",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "record:tests": "tsx scripts/record-tests.ts",
    "check": "npm run validate:pack && npm run test && npm run build && npm run lint:dist && npm run test:e2e && npm run record:tests && npm run build"
  },
  "dependencies": {
    "@actualizer/perception-core": "file:../perception-pathways-explorer/packages/perception-core",
    "@floating-ui/react": "0.27.20",
    "js-yaml": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.28.0",
    "remark-gfm": "4.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/cytoscape": "^3.21.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.17.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "lighthouse": "12.2.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
